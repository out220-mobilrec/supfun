# Базовый URL API. В dev проксируется Vite (см. vite.config.ts), поэтому можно оставить пустым.
VITE_API_BASE=/api
# URL для WebSocket подключения (namespace /chat). Пусто = window.location.origin (dev: прокси).
VITE_WS_URL=
# URL бэкенда для dev-proxy Vite (меняйте при другом порте сервера).
VITE_API_PROXY=http://localhost:3000