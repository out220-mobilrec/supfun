{
  "name": "supfun-api",
  "version": "0.1.0",
  "description": "SUP FUN API Server - NestJS",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
