# --- Database (PostgreSQL + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=sup_fun
# DB_SYNC=true auto-creates tables from entities (dev only).
# For prod set DB_SYNC=false and use `npm run migration:run`.
DB_SYNC=true

# --- App ---
PORT=3000
CORS_ORIGIN=*
# Global rate limit: requests per minute per IP
RATE_LIMIT_PER_MINUTE=500

# --- Auth (JWT) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Base URL of the web client used in email links
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# --- Email (SMTP, optional) ---
# Without MAIL_HOST the server logs outgoing emails instead of sending them,
# and /auth/verify-email + /auth/forgot-password return a devToken (non-production).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@supfun.app

# --- Push (FCM) ---
# Optional. Without these the server works, but no push notifications are sent.
# FCM_PRIVATE_KEY must keep real newlines (use \n as literal in the .env or a raw block)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Uploads ---
# Directory for uploaded images (default: <project>/uploads)
UPLOAD_DIR=
# Max image size in megabytes (default: 5)
UPLOAD_MAX_MB=5
